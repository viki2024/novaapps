
---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Servicios y precios | NovaApps">
    <main>
      <section class="introduccion">
        <h1>Servicios y precios</h1>
        <p>
          Descubre las herramientas de NovaApps y elige
          el plan que mejor se adapte a tu equipo.
        </p>
      </section>

      <section class="funcionalidades">
        <h2>¿Qué puedes hacer con NovaApps?</h2>

        <div class="contenedor-funciones">
          <article class="funcion">
            <h3>Planificación</h3>
            <p>Organiza actividades, fechas y recursos de tus proyectos.</p>
          </article>

          <article class="funcion">
            <h3>Tableros Kanban</h3>
            <p>Visualiza las tareas pendientes, en progreso y completadas.</p>
          </article>

          <article class="funcion">
            <h3>Colaboración</h3>
            <p>Comparte información y coordina el trabajo de tu equipo.</p>
          </article>

          <article class="funcion">
            <h3>Seguimiento</h3>
            <p>Consulta los avances y mantén el control de tus proyectos.</p>
          </article>
        </div>
      </section>

      <section class="planes">
        <h2>Elige tu plan</h2>

        <div class="contenedor-planes">
          <article class="tarjeta-plan">
            <h3>Profesional</h3>
            <p class="precio">$9.990 <span>/ mes</span></p>
            <p>Hasta 3 usuarios</p>
            <p>Plan anual: $99.990</p>
            <p>Gestión de tareas, Kanban y colaboración.</p>
          </article>

          <article class="tarjeta-plan">
            <h3>Empresa</h3>
            <p class="precio">$29.990 <span>/ mes</span></p>
            <p>Hasta 10 usuarios</p>
            <p>Plan anual: $299.990</p>
            <p>Gestión de equipos, seguimiento y reportes.</p>
          </article>
        </div>

        <p class="adicional">
          Usuario adicional: $3.000 mensuales.
        </p>
      </section>
    </main>
</Layout>

<style>
  body {
    margin: 0;
    font-family: var(--font-inter), Arial, sans-serif;
    background-color: #f5f6ff;
  }

  h1, h2, h3 {
    font-family: var(--font-poppins), Arial, sans-serif;
  }
  .enlace-logo {
    display: flex;
    align-items: center;
  }

  .enlace-logo :global(img) {
    width: 160px;
    height: auto;
  }

  nav {
    display: flex;
    gap: 30px;
    margin-left: auto;
  }

  nav a {
    color: white;
    text-decoration: none;
  }

  main {
    padding: 40px;
  }

  .introduccion {
    text-align: center;
    margin: 40px 0 60px;
  }

  .introduccion h1 {
    color: #4936cb;
    font-size: 40px;
  }

  .introduccion p {
    color: #353052;
    font-size: 18px;
  }

  .funcionalidades,
  .planes {
    text-align: center;
    margin-bottom: 60px;
  }

  .funcionalidades h2,
  .planes h2 {
    color: #4936cb;
    font-size: 32px;
  }

  .contenedor-funciones {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 30px;
  }

  .funcion {
    background-color: white;
    padding: 25px;
    border-radius: 12px;
  }

  .funcion h3 {
    color: #4936cb;
  }

  .funcion p {
    color: #353052;
    line-height: 1.6;
  }

  .contenedor-planes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    max-width: 900px;
    margin: 30px auto;
  }

  .tarjeta-plan {
    background-color: white;
    padding: 35px;
    border-radius: 12px;
    border: 2px solid #ddd0fa;
  }

  .tarjeta-plan h3 {
    color: #4936cb;
    font-size: 24px;
  }

  .tarjeta-plan p {
    color: #353052;
    line-height: 1.6;
  }

  .precio {
    font-size: 34px;
    font-weight: bold;
    color: #4936cb !important;
  }

  .precio span {
    font-size: 16px;
    font-weight: normal;
  }

  .adicional {
    color: #353052;
    font-size: 16px;
  }

  @media (max-width: 768px) {
    header {
      padding: 15px 20px;
    }

    .enlace-logo :global(img) {
      width: 130px;
    }

    nav {
      display: none;
    }

    main {
      padding: 20px;
    }

    .introduccion h1 {
      font-size: 30px;
    }

    .contenedor-funciones,
    .contenedor-planes {
      grid-template-columns: 1fr;
    }
  }
</style>
